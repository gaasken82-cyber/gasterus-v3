# Core app settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gasterus
REDIS_URL=redis://:redispass@localhost:6379
MEMBER_PROXY_SECRET=replace-with-32-plus-random-characters
ADMIN_PROXY_SECRET=replace-with-32-plus-random-characters
OPS_INTERNAL_SECRET=replace-with-32-plus-random-characters
SESSION_HMAC_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key

# Sportsbook provider toggles
PUBLIC_MARKET_ENABLED=true
# Full professional market board (O/U, Asian Handicap, BTTS, Correct Score, HT/FT,
# Team Totals, ...) built from the deterministic Gasterus Poisson model. ON in all
# environments by default. Set false to fall back to thin 1X2-only boards.
PUBLIC_MARKET_DERIVED_MARKETS_ENABLED=true
# CC0 OpenFootball fixtures (13 competitions) power the volume slate. ON by default.
PUBLIC_MARKET_OPENFOOTBALL_ENABLED=true
# OOM guard: only fixtures kicking off within this many days get the full derived-
# market treatment. OpenFootball season files carry ~380 matches/league; without
# this forward-window filter, building markets for ~5000 fixtures would spike heap.
# Raise only with a matching heap bump (CORE_HEAP_MB / WORKER_HEAP_MB).
PUBLIC_MARKET_OPENFOOTBALL_HORIZON_DAYS=21
# Slate size caps (all OOM-safe; Redis byte cap auto-trims if exceeded).
PUBLIC_MARKET_MAX_EVENTS=600
SPORTS_FEED_MAX_EVENTS=700
SPORTSBOOK_MEMBER_MAX_EVENTS=700
SPORTSBOOK_MEMBER_HORIZON_DAYS=45
FEED_WORKER_ENABLED=true
SPORTS_SOURCE_BACKGROUND_POLL_ENABLED=true

# Free-tier FootballData.io (works without paid sportsbook credentials)
FOOTBALLDATA_IO_ENABLED=true
FOOTBALLDATA_IO_KEY=replace-with-your-footballdata-io-key
FOOTBALLDATA_IO_BASE_URL=https://footballdata.io/api/v1
FOOTBALLDATA_IO_REFRESH_SECONDS=300
FOOTBALLDATA_IO_UPCOMING_LIMIT=500
SPORTS_PROVIDER_CACHE_MAX_ENTRIES=120
SPORTS_PROVIDER_CACHE_MAX_ENTRY_BYTES=3145728
SPORTS_PROVIDER_CACHE_MAX_TOTAL_BYTES=10000000

# Optional paid / commercial providers
API_SPORTS_ENABLED=true
API_SPORTS_KEY=
API_SPORTS_DAYS_AHEAD=14
THE_ODDS_API_ENABLED=true
THE_ODDS_API_KEY=
SHARP_API_ENABLED=true
SHARP_API_KEY=
THE_ODDS_API_SPORT_KEYS=soccer_australia_aleague,soccer_austria_bundesliga,soccer_belgium_first_div,soccer_brazil_campeonato,soccer_china_superleague,soccer_conmebol_libertadores,soccer_conmebol_sudamericana,soccer_denmark_superliga,soccer_efl_champ,soccer_england_league1,soccer_england_league2,soccer_fa_cup,soccer_france_ligue_one,soccer_france_ligue_two,soccer_germany_bundesliga,soccer_germany_bundesliga2,soccer_germany_liga3,soccer_greece_super_league,soccer_italy_serie_a,soccer_italy_serie_b,soccer_japan_j_league,soccer_korea_kleague1,soccer_mexico_ligamx,soccer_netherlands_eredivisie,soccer_netherlands_eerste_divisie,soccer_norway_eliteserien,soccer_poland_ekstraklasa,soccer_portugal_primeira_liga,soccer_spain_la_liga,soccer_spain_segunda_division,soccer_sweden_allsvenskan,soccer_switzerland_superleague,soccer_turkey_super_league,soccer_usa_mls,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_europa_conference_league
