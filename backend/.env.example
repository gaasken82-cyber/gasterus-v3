# Core app settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gasterus
REDIS_URL=redis://:redispass@localhost:6379
MEMBER_PROXY_SECRET=replace-with-32-plus-random-characters
ADMIN_PROXY_SECRET=replace-with-32-plus-random-characters
OPS_INTERNAL_SECRET=replace-with-32-plus-random-characters
SESSION_HMAC_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key

# Sportsbook provider toggles
PUBLIC_MARKET_ENABLED=true

# Free-tier FootballData.io (works without paid sportsbook credentials)
FOOTBALLDATA_IO_ENABLED=true
FOOTBALLDATA_IO_KEY=replace-with-your-footballdata-io-key
FOOTBALLDATA_IO_BASE_URL=https://footballdata.io/api/v1
FOOTBALLDATA_IO_REFRESH_SECONDS=300
FOOTBALLDATA_IO_UPCOMING_LIMIT=200

# Optional paid / commercial providers
API_SPORTS_ENABLED=false
API_SPORTS_KEY=
THE_ODDS_API_ENABLED=false
THE_ODDS_API_KEY=
SHARP_API_ENABLED=false
SHARP_API_KEY=
